# Copiez ce fichier en « .env » et renseignez vos valeurs. Le fichier .env n'est jamais versionné.

# --- Django ---
DJANGO_SECRET_KEY=            # obligatoire : chaîne aléatoire longue (python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_DEBUG=False            # True seulement en développement
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1   # domaines du site, séparés par des virgules

# --- Base de données (SQLite par défaut) ---
DB_ENGINE=sqlite3             # sqlite3 ou postgresql
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# --- Fichiers téléversés dans l'admin (images) ---
MEDIA_DIR=media               # dossier des images, relatif au projet
MEDIA_URL=media/              # adresse publique des images
# Stockage externe en production (facultatif), par exemple django-storages :
# MEDIA_STORAGE_BACKEND=storages.backends.s3.S3Storage
# MEDIA_STORAGE_OPTIONS={"bucket_name": "mon-bucket", "region_name": "eu-west-3"}

# --- Images : limites à l'upload ---
IMAGE_TAILLE_MAX_MO=5         # poids maximum d'une image
IMAGE_LARGEUR_MIN=600         # dimensions minimales en pixels
IMAGE_HAUTEUR_MIN=400
IMAGE_QUALITE_WEBP=82         # qualité des versions WebP générées (1 à 100)

# --- Paiement ---
PAYMENT_WEBHOOK_SECRET=       # secret partagé avec le prestataire de paiement (sans lui, le webhook est désactivé)

# --- E-mail (console en développement, SMTP en production) ---
EMAIL_BACKEND=                # vide = console si DEBUG, SMTP sinon
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=

# --- Règles métier (valeurs par défaut sûres, modifiables ici) ---
RETENUE_CARTE_MINUTES=15      # durée pendant laquelle une réservation par carte bloque les places
RETENUE_VIREMENT_MINUTES=2880 # idem pour un virement (48 h)
MAX_PLACES_PAR_COMMANDE=10
COMMANDES_EN_ATTENTE_MAX=3    # réservations non payées en même temps par compte (évite d'accaparer les places)
DEVISE_PAR_DEFAUT=EUR         # monnaie proposée à la création d'un événement (code à 3 lettres : EUR, XOF…), modifiable par événement

# --- API pour l'application (Expo / React Native) ---
# Ce serveur n'a pas d'interface web : il ne fait que répondre à l'application, sous /api/v1/ (et à l'administration sous /admin/).
# Sites web autorisés à appeler l'API depuis un navigateur (version WEB de l'application), séparés par des virgules.
# Inutile pour l'application mobile native. En développement : http://localhost:8081
CORS_ORIGINES_AUTORISEES=
# Adresse de l'application web : les liens des e-mails (vérification, mot de passe oublié) y mènent.
FRONT_URL=http://localhost:8081
JETON_DUREE_JOURS=30              # durée pendant laquelle l'application reste connectée sans se reconnecter

# --- Connexion ---
CONNEXION_TENTATIVES_MAX=5        # échecs de connexion autorisés par IP + e-mail…
CONNEXION_FENETRE_MINUTES=15      # …pendant cette durée (puis blocage temporaire)
SESSION_DUREE_JOURS=30            # durée de la session de l'administration

# --- Inscription et mot de passe oublié ---
VERIFICATION_EMAIL_JOURS=3        # durée de validité du lien de vérification de l'e-mail
RENVOI_VERIFICATION_SECONDES=60   # délai minimum entre deux demandes de renvoi du lien
MDP_LIEN_DUREE_HEURES=24          # durée de validité du lien « mot de passe oublié »
DEMANDES_COMPTE_MAX=10            # inscriptions / demandes de mot de passe par adresse IP, sur la durée CONNEXION_FENETRE_MINUTES

# --- Cookies de l'administration ---
COOKIE_PREFIXE=billetterie        # préfixe des cookies de ce site : évite les collisions avec d'autres projets Django sur la même adresse
