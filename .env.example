# Copie ce fichier en « .env » (il n'est jamais versionné) et renseigne les valeurs de ton projet Supabase
# (Project Settings → API). Après chaque changement : relancer Expo avec « npx expo start --clear ».

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
