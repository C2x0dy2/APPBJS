# Copie ce fichier en « .env » (il n'est jamais versionné) et renseigne l'adresse du serveur de l'application.
# Après chaque changement : relancer Expo avec « npx expo start --clear ».

# Adresse de l'API (sans « /api/v1 » ni « / » final).
#   - Navigateur sur le même ordinateur : http://localhost:8000
#   - Téléphone ou émulateur : l'adresse de l'ordinateur sur le réseau, par exemple http://192.168.1.20:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
