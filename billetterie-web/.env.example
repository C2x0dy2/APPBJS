# Variables locales. Les valeurs de production se configurent dans Sites.
# true pour la démonstration locale ; false en production.
DEMO_MODE=true
# Obligatoire en production : sert aux liens de commande et aux retours Stripe.
APP_URL=http://127.0.0.1:5173
ADMIN_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
MAIL_FROM=
# Secret du cron POST /api/maintenance (Authorization: Bearer …).
JOB_SECRET=
# Chiffre la clé de signature des billets au repos (AES-GCM). Recommandé en production.
KEY_ENCRYPTION_SECRET=
